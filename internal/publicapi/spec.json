{
  "openapi": "3.1.0",
  "info": {
    "title": "Vortex Password Manager",
    "version": "0.1.0",
    "description": "Agent credential broker. Use injects the secret at the edge. Responses never include vault material. CLI, MCP, and generated SDKs are projections of this contract."
  },
  "servers": [
    { "url": "https://pwm.vortex.nyc" }
  ],
  "tags": [
    { "name": "Agent", "description": "Bearer is the agent. listItems is metadata. useItem injects. Never GetSecret." }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["Agent"],
        "security": [],
        "summary": "Liveness. No secrets.",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "text/plain": {
                "schema": { "type": "string", "examples": ["ok\n"] }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "tags": ["Agent"],
        "security": [],
        "summary": "This contract.",
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/v1/items": {
      "get": {
        "operationId": "listItems",
        "tags": ["Agent"],
        "summary": "Items this agent may Use. Names and URIs. Never secrets.",
        "responses": {
          "200": {
            "description": "Granted items",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ItemsResponse" }
              }
            }
          },
          "401": { "description": "missing or invalid Bearer" }
        }
      }
    },
    "/v1/use": {
      "post": {
        "operationId": "useItem",
        "tags": ["Agent"],
        "summary": "Call a URL as this agent. The broker injects the credential. The vault secret is never in the response.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UseRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision plus upstream result, scrubbed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UseResponse" }
              }
            }
          },
          "400": { "description": "bad request" },
          "401": { "description": "missing or invalid Bearer" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Hydra client_credentials JWT or bound OIDC. Identity is the agent. The host is not identity."
      }
    },
    "schemas": {
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "org_id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["api_key", "oauth", "ssh", "file"] },
          "owner": { "$ref": "#/components/schemas/Owner" },
          "uris": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "archived": { "type": "boolean" },
          "has_totp": { "type": "boolean" },
          "has_file": { "type": "boolean" }
        },
        "required": ["id", "org_id", "name", "kind", "owner", "uris"]
      },
      "Owner": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string" },
          "id": { "type": "string" }
        },
        "required": ["kind", "id"]
      },
      "ItemsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Item" }
          }
        }
      },
      "UseRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "url"],
        "properties": {
          "item": { "type": "string", "description": "Granted item name" },
          "url": { "type": "string", "description": "Absolute URL. Host must match the item." },
          "method": { "type": "string", "default": "GET" },
          "headers": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Extra request headers. Never the vault secret."
          },
          "body": { "type": "string", "description": "Request body. Never the vault secret. Use --body-file on the CLI." }
        }
      },
      "UseResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision"],
        "properties": {
          "decision": { "type": "string", "enum": ["allow", "deny", "need_approval"] },
          "reason": { "type": "string" },
          "approval_id": { "type": "string" },
          "status": { "type": "integer" },
          "body": { "type": "string", "description": "Upstream body with vault secrets scrubbed." }
        }
      }
    }
  }
}
